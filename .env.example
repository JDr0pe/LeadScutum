# =======================================================
# Configurações do LeadScutum & Mailtrap
# Copie este arquivo para .env e preencha com seus dados
# =======================================================
# LeadScutum & Mailtrap settings
# Copy this file to .env and fill in your details
# =======================================================

# Token da API Mailtrap (obtenha em: Mailtrap -> Settings -> API Tokens)
# Mailtrap API token (get it at: Mailtrap -> Settings -> API Tokens)
MAILTRAP_API_TOKEN=""

# Remetente do e-mail (no plano gratuito de testes, use hello@demomailtrap.co)
# Email sender (for the free trial plan, use hello@demomailtrap.co)
MAILTRAP_SENDER_EMAIL="hello@demomailtrap.co"
MAILTRAP_SENDER_NAME="LeadScutum Compliance"

# E-mails de destino para onde a esteira despachará os alertas:
# No Mailtrap gratuito com domínio de teste, use o e-mail cadastrado na sua conta
# Destination emails where the pipeline will send alerts:
# For the free Mailtrap plan with a test domain, use the email registered to your account.
EMAIL_DESTINO_COMERCIAL="seuemail@mail.com"
EMAIL_DESTINO_JURIDICO="seuemail@mail.com"
